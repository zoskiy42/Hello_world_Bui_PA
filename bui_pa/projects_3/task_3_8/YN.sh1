#!/bin/bash

echo "Скрипт обновит систему через 5 секунд."
# -t 5 — ждем 5 сек, -n 1 — ждем нажатия одной клавиши
read -t 5 -n 1 -p "Отменить обновление? (y/n): " CANCEL

if [[ "$CANCEL" == "y" || "$CANCEL" == "Y" ]]; then
    echo -e "\nОбновление отменено пользователем."
else
    echo -e "\nВремя вышло или подтверждено. Начинаю обновление..."
fi
